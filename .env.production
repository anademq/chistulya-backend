# ═══════════════════════════════════════════════════════════════════════════════
# Chistulya - Production Environment
# ═══════════════════════════════════════════════════════════════════════════════

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Чистюля"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.xn--h1agrefu5d.xn--p1ai
APP_FRONTEND_URL="https://чистуля.рф"
APP_TIMEZONE=Europe/Moscow

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

GRAPHIQL_ENABLED=false

BCRYPT_ROUNDS=12

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# The postgres image reads POSTGRES_*; Laravel reads DB_*.
POSTGRES_DB=chistulya
POSTGRES_USER=chistulya
POSTGRES_PASSWORD=

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ── GraphQL ───────────────────────────────────────────────────────────────────
GRAPHQL_MAX_DEPTH=15
GRAPHQL_MAX_COMPLEXITY=1000

# Introspection lets any client dump the whole schema. Kept on because client
# codegen relies on it — set to true if codegen runs against staging instead.
GRAPHQL_DISABLE_INTROSPECTION=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated. Defaults to APP_FRONTEND_URL when left empty.
# A Cyrillic domain is expanded to its punycode form automatically.
# CORS_ALLOWED_ORIGINS=
# CORS_PATHS=graphql,graphql/*,broadcasting/auth,up
# CORS_ALLOWED_METHODS=*
# CORS_ALLOWED_HEADERS=*
# CORS_ALLOWED_ORIGIN_PATTERNS=
# CORS_EXPOSED_HEADERS=
# CORS_MAX_AGE=86400
# CORS_SUPPORTS_CREDENTIALS=false

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.xn--h1agrefu5d.xn--p1ai

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Broadcasting (Laravel Reverb) ─────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

# Internal: used by app/queue containers to connect to the reverb container
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Frontend clients connect through nginx (wss://api.чистуля.рф/app/KEY)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=api.xn--h1agrefu5d.xn--p1ai
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ── Filesystem (MinIO / S3) ───────────────────────────────────────────────────
# Same pattern as postgres: MinIO reads MINIO_ROOT_*, Laravel reads AWS_*.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Web console. Leave off in production; set to "on" only to debug.
MINIO_BROWSER=off

FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=app
AWS_ENDPOINT=http://minio:9000
AWS_URL=https://storage.xn--h1agrefu5d.xn--p1ai
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Mail (SMTP) ───────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=host.docker.internal
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_VERIFY_PEER=false
MAIL_FROM_ADDRESS="no-reply@чистуля.рф"
MAIL_FROM_NAME="ЧИСТУЛЯ.РФ"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
